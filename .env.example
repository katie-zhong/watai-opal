# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Discord webhook for reminders + digests (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Shared secret so only Vercel Cron can hit /api/cron/reminders
CRON_SECRET=change-me
